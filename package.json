{
  "name": "@get-coral/ui",
  "packageManager": "pnpm@10.32.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Get-Coral/coral-ui.git"
  },
  "version": "1.0.2",
  "description": "Shared Coral UI components and design tokens for building Jellyfin module interfaces",
  "homepage": "https://getcoral.dev",
  "bugs": {
    "url": "https://github.com/Get-Coral/coral-ui/issues"
  },
  "license": "MIT",
  "author": "Coral",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "biome check . && pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint . --write",
    "format": "biome format . --write",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "coral",
    "design-system",
    "design-tokens",
    "ui",
    "ui-components",
    "react",
    "components",
    "jellyfin",
    "self-hosted",
    "tailwindcss"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@get-coral/biome-config": "^0.2.0",
    "@get-coral/tsconfig": "^0.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^28.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
